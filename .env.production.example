# =============================================================
# Nova Wood — Production Environment Variables Configuration
# Copy this template to .env on your Hostinger production server
# =============================================================

# ---- SYSTEM ENVIRONMENT ----
NODE_ENV=production
PORT=4000

# ---- DATABASE & CACHE ----
# Replace with your Hostinger MySQL DB credentials
DATABASE_URL="mysql://u951829634_user:SecureDBPassword@localhost:3306/u951829634_nova_wood"

# Redis Cache Configuration (Optional, set to empty if Redis is not used)
REDIS_URL="redis://127.0.0.1:6379"
REDIS_TTL=3600

# ---- SECURITY & TOKENS ----
# Replace with random cryptographically secure strings (e.g. openssl rand -base64 32)
JWT_SECRET="YOUR_PRODUCTION_JWT_SECRET_KEY_CHANGE_ME"
JWT_REFRESH_SECRET="YOUR_PRODUCTION_JWT_REFRESH_SECRET_KEY_CHANGE_ME"

JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- DOMAINS & CORS ----
# URLs of your storefront, admin dashboard and REST API
FRONTEND_URL="https://novawoodeg.com"
ADMIN_URL="https://admin.novawoodeg.com"
API_URL="https://api.novawoodeg.com"
API_PREFIX="/api/v1"

# ---- MEDIA & UPLOADS ----
# Upload directory path on host filesystem
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880 # 5MB in bytes

# ---- INTERNATIONALIZATION ----
DEFAULT_LOCALE="ar"
SUPPORTED_LOCALES="ar,en"

# ---- SMTP EMAIL CONFIGURATION ----
# For order confirmation and password reset emails
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="noreply@novawoodeg.com"
SMTP_PASS="YourSecureEmailPassword"
SMTP_FROM="Nova Wood <noreply@novawoodeg.com>"
