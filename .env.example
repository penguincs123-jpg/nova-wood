# ============================================================
# Nova Wood — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---- Database (MySQL via Prisma) ----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://u951829634_nova_wood:YOUR_DB_PASSWORD@auth-db1797.hstgr.io:3306/u951829634_nova_wood"

# ---- JWT Auth ----
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Redis (optional, for caching) ----
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# ---- File Upload & Image Processing ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
IMAGE_QUALITY_WEBP=85
IMAGE_QUALITY_AVIF=80
# CDN base URL (leave empty to serve locally)
CDN_BASE_URL=

# ---- Email (Nodemailer) ----
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@novawoodeg.com
SMTP_PASS=your_email_password
EMAIL_FROM_NAME=Nova Wood
EMAIL_FROM_ADDRESS=noreply@novawoodeg.com

# ---- Localization ----
DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,en

# ---- Admin ----
ADMIN_EMAIL=admin@novawoodeg.com
ADMIN_PASSWORD=ChangeMe@12345
